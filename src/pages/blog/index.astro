---
import Layout from '../../layouts/Layout.astro';
import BackToHome from '../../components/BackToHome';
import { buildBreadcrumb } from '../../lib/seo';

const canonicalUrl = 'https://asimali.online/blog/';

const posts = [
  {
    href: '/blog/laravel-application-structure',
    title: 'How I Structure a Laravel Application for Long-Term Maintenance',
    description:
      'Service layers, model discipline, authorization as data, queues, state machines, and query hygiene — the structure that keeps a Laravel codebase workable after year one.',
    date: '2026-10-13',
  },
];

const jsonLd = [
  {
    "@type": "Blog",
    "@id": "https://asimali.online/blog/#blog",
    "url": canonicalUrl,
    "name": "Asim Ali — Laravel & Backend Engineering Blog",
    "description":
      "Practical notes on Laravel application architecture, database optimization, queue-based processing, and backend engineering from production enterprise systems.",
    "author": { "@id": "https://asimali.online/#asim-ali" }
  },
  buildBreadcrumb('blog', 'Blog')
];
---

<Layout
  title="Blog — Laravel & Backend Engineering Notes | Asim Ali"
  description="Practical articles on Laravel application architecture, database optimization, and backend engineering — written from production systems."
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <main id="main-content" class="w-full">
    <div class="mx-auto w-full max-w-[860px] px-5 sm:px-8 lg:px-12 pt-24 sm:pt-28 pb-16 flex flex-col">
      <BackToHome />
      <p class="text-[12px] uppercase tracking-[0.14em] text-orange font-semibold mb-4">Writing</p>
      <h1 class="text-[40px] sm:text-[58px] lg:text-[68px] font-bold text-white leading-[100%] tracking-normal font-display">
        Blog
      </h1>
      <p class="text-[18px] sm:text-[20px] text-muted leading-[140%] font-display mt-6 max-w-[660px]">
        Notes from building and maintaining production Laravel systems —
        architecture decisions, performance work, and the mistakes that taught
        me where the structure actually matters.
      </p>

      <section class="mt-12 flex flex-col gap-3">
        {posts.map((post) => (
          <a
            href={post.href}
            class="group flex items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:p-6 transition-colors hover:border-orange/40"
          >
            <div class="min-w-0">
              <h2 class="text-[18px] sm:text-[21px] font-semibold text-white leading-[125%] font-display">
                {post.title}
              </h2>
              <p class="text-[14px] sm:text-[15px] text-muted leading-[150%] font-display mt-2.5">
                {post.description}
              </p>
              <time class="text-[12.5px] text-dim font-display mt-3 block" datetime={post.date}>
                {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
          </a>
        ))}
      </section>
    </div>
  </main>
</Layout>
