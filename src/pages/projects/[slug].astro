---
import Layout from '../../layouts/Layout.astro';
import ProjectDetailRoot from '../../components/ProjectDetailRoot';
import { getProjectBySlug, getAllProjectSlugs } from '../../data/projects';

export async function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map((slug) => ({
    params: { slug },
    props: { project: getProjectBySlug(slug)! },
  }));
}

const { project } = Astro.props;

const pageTitle = `${project.title} — ${project.niche} | Asim Ali`;
const pageDescription = `${project.niche}. ${project.overview ? project.overview.slice(0, 155) : ''}...`;
const heroImage = project.image || 'https://asimali.online/opengraph-image.png';
const canonicalUrl = `https://asimali.online/projects/${project.slug}`;

const projectJsonLd = [
  {
    "@type": "CreativeWork",
    "@id": `${canonicalUrl}#creativework`,
    "url": canonicalUrl,
    "name": project.title,
    "headline": `${project.title} — ${project.niche}`,
    "description": project.overview || project.niche,
    "author": { "@id": "https://asimali.online/#asim-ali" },
    "keywords": project.tags ? project.tags.join(', ') : '',
    "creator": { "@id": "https://asimali.online/#asim-ali" }
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://asimali.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": project.title,
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={heroImage}
  type="article"
  canonicalUrl={canonicalUrl}
  jsonLd={projectJsonLd}
>
  <ProjectDetailRoot project={project} client:load />
</Layout>
