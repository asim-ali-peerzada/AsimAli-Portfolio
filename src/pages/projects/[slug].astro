---
import Layout from '../../layouts/Layout.astro';
import ProjectDetailRoot from '../../components/ProjectDetailRoot';
import { getProjectBySlug, getAllProjectSlugs } from '../../data/projects';

export async function getStaticPaths() {
  const slugs = getAllProjectSlugs();
  return slugs.map((slug) => ({
    params: { slug },
    props: { project: getProjectBySlug(slug)! },
  }));
}

const { project } = Astro.props;

/**
 * Keeps the title inside the ~60 char SERP budget. Project titles run long, so
 * drop a trailing "| Asim Ali" suffix rather than letting Google truncate the
 * word that carries the Laravel signal.
 */
const rawTitle = `${project.title} — Laravel Project by Asim Ali`;
const pageTitle =
  rawTitle.length <= 60 ? rawTitle : `${project.title.slice(0, 54).replace(/[\s—&(\/-]+$/, '')} | Asim Ali`;

const overview = project.overview || '';
const pageDescription = overview
  ? `${overview.slice(0, 150).replace(/\s+\S*$/, '')}...`
  : `${project.title}. A Laravel project by Asim Ali.`;
const heroImage = project.image || 'https://asimali.is-a.dev/opengraph-image.png';
const canonicalUrl = `https://asimali.is-a.dev/projects/${project.slug}`;

const projectJsonLd = [
  {
    "@type": "CreativeWork",
    "@id": `${canonicalUrl}#creativework`,
    "url": canonicalUrl,
    "name": project.title,
    "headline": `${project.title} — ${project.niche}`,
    "description": project.overview || project.niche,
    "about": "Laravel",
    "creator": { "@id": "https://asimali.is-a.dev/#asim-ali" },
    "keywords": ["Laravel", "PHP", ...(project.tags || [])].join(', ')
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://asimali.is-a.dev/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": project.title,
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={heroImage}
  type="article"
  canonicalUrl={canonicalUrl}
  jsonLd={projectJsonLd}
>
  <ProjectDetailRoot project={project} client:load />
</Layout>
