---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description = 'PHP Laravel developer and backend engineer building enterprise SaaS, REST APIs, secure identity, and workflow automation. Hire a PHP Laravel backend engineer for scalable systems.',
  image = 'https://asimali.is-a.dev/opengraph-image.png',
  type = 'website',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://asimali.is-a.dev';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

import '@/styles/global.css';
import Navbar from '../components/Navbar';
import { withBase } from '@/lib/base';

const baseSchemaGraph = [
  {
    "@type": "WebSite",
    "@id": "https://asimali.is-a.dev/#website",
    "url": "https://asimali.is-a.dev/",
    "name": "Asim Ali - Software Developer Portfolio",
    "description": "Official portfolio of Asim Ali, a Software Engineer from Punjab, Pakistan specializing in Laravel, React, and scalable web applications.",
    "publisher": { "@id": "https://asimali.is-a.dev/#asim-ali" }
  },
  {
    "@type": "Person",
    "@id": "https://asimali.is-a.dev/#asim-ali",
    "name": "Asim Ali",
    "givenName": "Asim",
    "familyName": "Ali",
    "url": "https://asimali.is-a.dev/",
    "jobTitle": "Backend Engineer",
    "alternateName": ["Backend Engineer", "PHP Developer", "Laravel Developer", "Software Engineer"],
    "description": "Asim Ali is a Backend Engineer specializing in PHP and Laravel, architecting enterprise systems, identity integrations, and automated workflows. Based in Punjab, Pakistan, with 3 years of professional experience building enterprise SaaS platforms, role- and graph-scoped access control, and stateful workflow systems.",
    "image": "https://asimali.is-a.dev/opengraph-image.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "asimalipeerzada@gmail.com",
      "contactType": "professional"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hasilpur",
      "addressRegion": "Punjab",
      "addressCountry": "Pakistan"
    },
    "email": "asimalipeerzada@gmail.com",
    "knowsAbout": [
      "PHP", "Laravel", "React", "JavaScript", "TypeScript",
      "MySQL", "Redis", "REST API", "WebSockets", "Git",
      "Enterprise SaaS", "RBAC", "ABAC", "JWT Authentication", "SSO",
      "Queue-Based Processing", "ETL Pipelines", "OCR",
      "RAG Engines", "Vector Databases", "LLM Integration"
    ],
    "knowsLanguage": ["en", "ur"],
    "sameAs": [
      "https://linkedin.com/in/the-asimali",
      "https://github.com/asim-ali-peerzada"
    ]
  },
  {
    "@type": "ProfessionalService",
    "name": "Asim Ali — Software Engineering Services",
    "description": "Enterprise SaaS development, Laravel backend architecture, React frontend development, CRM automation, identity management, and AI integration services.",
    "provider": { "@id": "https://asimali.is-a.dev/#asim-ali" },
    "url": "https://asimali.is-a.dev/",
    "areaServed": "Worldwide",
    "serviceType": [
      "Enterprise SaaS Development",
      "Laravel Backend Architecture",
      "React Frontend Development",
      "CRM & Sales Automation",
      "Identity & Access Management",
      "Workflow Automation",
      "REST API Engineering",
      "AI & LLM Integration"
    ]
  }
];

const mergedSchemaGraph = jsonLd
  ? [...baseSchemaGraph, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : baseSchemaGraph;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Preconnect hints -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" />

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>

  <!-- Google Analytics (deferred for LCP) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8S0QQM9138"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.addEventListener('load', function() {
      gtag('js', new Date());
      gtag('config', 'G-8S0QQM9138');
    });
  </script>

  <!-- SEO Meta Tags -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Asim Ali" />
  <meta name="keywords" content="Asim Ali, PHP Laravel developer, Laravel developer, PHP developer, backend engineer, software developer, hire Laravel developer, hire backend engineer, enterprise SaaS, REST API, OAuth 2.0, SSO, workflow automation, queue processing" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="Asim Ali Portfolio" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- Favicon & Canonical -->
  <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#151312" />
  <meta name="msvalidate.01" content="48F444AC64A76EC4DC734CFA29E94FD8" />

  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": mergedSchemaGraph
  })} />
</head>
<body>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-[#10b981] focus:text-white focus:rounded-md focus:shadow-lg"
  >
    Skip to main content
  </a>
  {/* pathname is injected at build time so the server-rendered HTML already
      highlights the right nav item, instead of correcting after hydration. */}
  <Navbar pathname={Astro.url.pathname} client:load />
  <slot />
</body>
</html>
